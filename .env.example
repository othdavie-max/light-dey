# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never paste this in a chat, a screenshot or a public place.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# A long random phrase used to scramble IP addresses before storing them (we never store raw IPs)
IP_HASH_SALT=
